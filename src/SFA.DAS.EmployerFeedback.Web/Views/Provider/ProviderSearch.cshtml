@using SFA.DAS.EmployerFeedback.Web.Configuration.Routing
@using SFA.DAS.EmployerFeedback.Web.Models.Shared
@model ProviderSearchViewModel

@{ 
    ViewBag.PageID = "page-service-start";
    ViewBag.Title = "Provide Feedback";
    ViewBag.MetaDesc = "Provide feedback on training providers";
    ViewBag.HideNav = "true";
}

<a class="govuk-back-link" href="@Model.BackUrl">Back</a>

<main class="govuk-main-wrapper govuk-main-wrapper--auto-spacing" id="main-content" role="main">

    @if (0 == Model.UnfilteredTotalRecordCount)
    {
        <partial name="_NoProvidersPartial" />
    }
    else
    {
        <partial name="_SelectProviderPartial" />
    }

</main>
