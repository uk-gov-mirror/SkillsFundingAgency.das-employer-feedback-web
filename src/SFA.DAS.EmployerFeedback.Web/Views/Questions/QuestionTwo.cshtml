@using SFA.DAS.EmployerFeedback.Web.Controllers
@using SFA.DAS.EmployerFeedback.Web.Models.Questions
@model QuestionTwoWeaknessesViewModel
@{
    ViewBag.PageID = "page-weaknesses-question";
    ViewBag.Title = "Providers Weaknesses";
}

<a asp-route="@QuestionsController.QuestionOneGet" asp-route-encodedAccountId="@Model.EncodedAccountId" class="govuk-back-link">Back</a>

<main class="govuk-main-wrapper govuk-main-wrapper--auto-spacing" id="main-content">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <partial name="_ValidationSummary" />
            <form asp-route="@QuestionsController.QuestionTwoPost" method="post">
                <h1 class="govuk-heading-l">How could @Model.ProviderName improve?</h1>
                <div id="Attributes" class="govuk-form-group" das-highlight-error-for="Attributes" error-class="govuk-form-group--error">
                    <p das-validation-for="Attributes" class="govuk-error-message"></p>
                    <fieldset name="areas-to-improve" aria-describedby="areas-to-improve-hint" class="govuk-fieldset checkbox-limit">
                         <legend class="govuk-fieldset_legend govuk-fieldset_legend--1">
                             <h2 class="govuk-heading-m">Does @Model.ProviderName need to improve any of these?</h2>
                        </legend>
                        <div id="areas-to-improve-hint" class="govuk-hint">
                            It's optional. You can choose up to 3.
                        </div>
                        <input type="hidden" asp-for="@Model.ProviderName" />
                        <div class="govuk-checkboxes" data-module="govuk-checkboxes">
                            @for (var i = 0; i < Model.Attributes.Count; i++)
                            {
                                <div class="govuk-checkboxes__item" style="@(Model.Attributes[i].Good ? "display: none" : "");">
                                    <checkbox asp-for="@Model.Attributes[i].Bad" id="col1-@i" type="checkbox" class="govuk-checkboxes__input" label="@Model.Attributes[i].Name" />
                                    <input asp-for="@Model.Attributes[i].Name" type="hidden" />
                                </div>
                            }
                        </div>
                    </fieldset>
                </div>
                <div class="govuk-button-group">
                    <button id="q2-continue" type="submit" class="govuk-button">Continue</button>
                </div>
            </form>
        </div>
    </div>
</main>