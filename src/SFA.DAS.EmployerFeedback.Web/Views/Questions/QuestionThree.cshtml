@using SFA.DAS.EmployerFeedback.Web.Controllers
@using SFA.DAS.EmployerFeedback.Web.Models.Questions
@model QuestionThreeRatingViewModel
@{ 
    ViewBag.PageID = "page-overall-quality-question";
    ViewBag.Title = "Provide Feedback"; 
    var backRoute = Model.ReturnToReviewAnswers ? ReviewAnswersController.ReviewAnswersGet : QuestionsController.QuestionTwoGet;
}

<a asp-route="@backRoute" asp-route-encodedAccountId="@Model.EncodedAccountId" class="govuk-back-link">Back</a>

<main class="govuk-main-wrapper govuk-main-wrapper--auto-spacing" id="main-content">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <partial name="_ValidationSummary" />
            <form asp-route="@QuestionsController.QuestionThreePost">
                <h1 class="govuk-heading-l">Overall rating</h1>
                <div class="govuk-form-group" das-highlight-error-for="Rating" error-class="govuk-form-group--error">
                    <p das-validation-for="Rating" class="govuk-error-message"></p>
                    <fieldset name="overall-rating" class="govuk-fieldset">
                    <legend class="govuk-fieldset_legend govuk-fieldset_legend--1">
                        <h2 class="govuk-heading-m">How would you rate @(Model.ProviderName.EndsWith("'s") ? @Model.ProviderName : $"{@Model.ProviderName}'s") training and service overall?</h2>
                    </legend>
                    <input type="hidden" asp-for="@Model.ProviderName" />
                    <div class="govuk-radios" data-module="govuk-radios">
                        <div class="govuk-radios__item">
                            <input class="govuk-radios__input" asp-for="Rating" das-highlight-error-for="Rating" error-class="govuk-input--error" type="radio" value="@ProviderRating.Excellent">
                            <label class="govuk-label govuk-radios__label" for="Rating">@ProviderRating.Excellent</label>
                        </div>
                        <div class="govuk-radios__item">
                            <input class="govuk-radios__input" id="Rating-good" asp-for="Rating" type="radio" value="@ProviderRating.Good">
                            <label class="govuk-label govuk-radios__label" for="Rating-good">@ProviderRating.Good</label>
                        </div>
                        <div class="govuk-radios__item">
                            <input class="govuk-radios__input" id="Rating-poor" asp-for="Rating" type="radio" value="@ProviderRating.Poor">
                            <label class="govuk-label govuk-radios__label" for="Rating-poor">@ProviderRating.Poor</label>
                        </div>
                        <div class="govuk-radios__item">
                            <input class="govuk-radios__input" id="Rating-veryPoor" asp-for="Rating" type="radio" value="@ProviderRating.VeryPoor">
                            <label class="govuk-label govuk-radios__label" for="Rating-veryPoor">@ProviderRating.VeryPoor.GetDisplayName()</label>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="govuk-button-group">
                <button id="q3-continue" type="submit" class="govuk-button">Continue</button>
            </div>
            <input asp-for="@Model.ReturnToReviewAnswers" type="hidden" />
        </form>
        </div>
    </div>
</main>