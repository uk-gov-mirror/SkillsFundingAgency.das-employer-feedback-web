@using Microsoft.Extensions.Options;
@using SFA.DAS.Employer.Shared.UI.Models
@using SFA.DAS.EmployerFeedback.Web.ViewDataKeys
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var accountId = ViewContext.RouteData.Values[RouteValueKeys.EncodedAccountId] as string;
    ViewBag.HideHeaderBorder = true;
    var cookieBannerModel = new CookieBannerModel { AccountId = accountId };
    var footerModel = new FooterModel { AccountId = accountId, UsePrivacyV2 = true };

    var hideHeader = (bool)ViewData[ViewDataKeys.HideAccountNavigation];
    var hideNavigationLinks = !(bool)ViewData[ViewDataKeys.ShowNav];
    var zendeskSectionId = Config.ZendeskSectionId;
}

<!DOCTYPE html>
<html lang="en" class="govuk-template govuk-template--rebranded">
<head>
    <partial name="_GoogleAnalytics" model="GoogleAnalyticsTag.Head" />
    <meta charset="utf-8" />
    <title>@(ViewData["Title"] ?? "Manage apprenticeships")</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#1d70b8" />

    <link rel="icon" sizes="48x48" href="/assets/rebrand/images/favicon.ico" />
    <link rel="icon" sizes="any" href="/assets/rebrand/images/favicon.svg" type="image/svg+xml" />
    <link rel="mask-icon" href="/assets/rebrand/images/govuk-icon-mask.svg" color="#1d70b8" />
    <link rel="apple-touch-icon" href="/assets/rebrand/images/govuk-icon-180.png" />

    <!--[if !IE 8]><!-->
    <link href="css/main.css" rel="stylesheet" />
    <link href="/css/application.css" rel="stylesheet" no-cdn />
    <!--<![endif]-->

    <meta property="og:image" content="assets/images/govuk-opengraph-image.png">
    @Html.Raw(JavaScriptSnippet.FullScript) <!-- AppInsights script -->
</head>
<body class="govuk-template__body">
    <partial name="_GoogleAnalytics" model="GoogleAnalyticsTag.Body" />

    <script>document.body.className = document.body.className ? document.body.className + ' js-enabled' : 'js-enabled';</script>

    <a href="#main-content" class="govuk-skip-link">Skip to main content</a>

    <partial name="_CookieBanner" model="@cookieBannerModel" />

    <partial name="_Header" model="@accountId" />

    <div class="govuk-phase-banner govuk-width-container">
        <p class="govuk-phase-banner__content">
            <strong class="govuk-tag govuk-phase-banner__content__tag">
                beta
            </strong>
            <span class="govuk-phase-banner__text">
                This is a new service.
            </span>
        </p>
    </div>

    <div class="govuk-width-container">
        @RenderBody()
    </div>

    <partial name="_Footer" model="@footerModel" />
    <partial name="_GoogleAnalyticsInfo" />

    <script type="module" src="/libs/govuk-frontend/govuk-frontend.min.js"></script>
    <script type="module" nws-csp-add-nonce="true">
        import {
            initAll
        } from '@Configuration["cdn:url"]/libs/govuk-frontend/govuk-frontend.min.js'
        initAll()
    </script>
    <script src="libs/jquery/jquery.min.js"></script>
    <script src="js/das-all.js"></script>
    <script src="js/app.min.js"></script>
    <script src="/js/application.js" no-cdn></script>
    <script>
        window.GOVUKFrontend.initAll();
        window.DASFrontend.initAll();
    </script>

    <script type="text/javascript">
        window.zESettings = {
            webWidget: {
                contactForm: {
                    attachments: false
                },
                chat: {
                    talk: {
                        nickname: "Tier 1 Support - Apprenticeships"
                    },
                    menuOptions: {
                        emailTranscript: false
                    }
                },
                helpCenter: {
                    filter: {
                        section: "@zendeskSectionId"
                    }
                }
            }
        };
    </script>
    <script id="ze-snippet" src="https://static.zdassets.com/ekr/snippet.js?key=1b1ce288-39ea-4d40-a5e1-3a5e08aadd89" integrity="sha384-LEAg7Hn/UKSw48yppzHGxCqcbENHoEb53egKK9eRLlOCW27Vsu+2rrxZJc5gwMAJ" crossorigin="anonymous"></script>
    <script id="co-snippet" src="https://embed-euw1.rcrsv.io/h6255jcoYuIOGsFnsagb3xgrbKz9mHeBGjifWcngdcP05WZQu46kKykuID1LpD9d?zwwi=1" integrity="sha384-7EDWuzfKf7oWDf42kLKCFgvzfyjhQK3j/oagNpCjnKcewf3X4KwjbTIn5TXlb1mp" crossorigin="anonymous"></script>
    @Html.SetZenDeskLabels($"emfb-{ViewBag.Title}")
</body>
</html>